ENV=testing
DEFAULT_COMMAND_CHANNEL=generic-extraction-plugin-commands

# Database
DATABASE_HOST=test-database
DATABASE_PORT=5432
DATABASE_DB=test_deps
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
MASTER_CHANGELOG=./migrations/master.yaml
TESTING=true
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

SENTRY_ENABLED=False
SENTRY_DSN=

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@test-rabbitmq:5672/test_deps

AI_FUSION_URL=http://deps-ai-fusion:8000
DOCUMENT_TYPE_URL=http://deps-document-type:8000

# kafka
KAFKA_GROUP_ID=extraction

# Auth
AUTH_ENABLED=false
AUTH_VERIFY_SSL=false
API_KEY=empty_key

# Possible values: none, user, organisation
ACCESS_MODE=none
DEFAULT_ORGANISATION=deps-users
ADMINS_GROUP=deps-admins

LLM_EXTRACTION_GROUPING_FACTOR=5
